# ==============================================================================
# Backend Environment Configuration
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
API_VERSION=v1
BASE_URL=http://localhost:3000

# Database Configuration
MONGOURI=mongodb://localhost:27017/golden_crust_bakery

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# Safaricom Daraja M-Pesa Configuration (Sandbox / Production)
CONSUMER_KEY=your_daraja_consumer_key
CONSUMER_SECRET=your_daraja_consumer_secret
PASS_KEY=your_daraja_lipa_na_mpesa_passkey
# Optional comma-separated Safaricom IP whitelist for callback verification
SAFARICOM_IPS=196.201.214.200,196.201.214.206,196.201.213.114,196.201.214.207,196.201.214.208,196.201.213.44,196.201.212.127,196.201.212.138

# Cloudinary Media Storage Configuration
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_SECRET_KEY=your_cloudinary_api_secret

# Initial Admin Seeding (Used by src/scripts/admin.ts)
ADMIN_EMAIL=admin@goldencrust.com
ADMIN_PASSWORD=change_this_secure_admin_password
